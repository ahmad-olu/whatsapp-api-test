# Copy to .env for local runs (the server loads ./.env; real env vars win).
# On Railway, set these as service Variables instead.

# --- required ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gateway
# Any string you invent. You paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Meta app dashboard -> App settings -> Basic -> App secret. Used to verify
# the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=
# Protects /admin/*. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-admin-token

# --- WhatsApp credentials (needed for sending + media download) -------------
# Meta dashboard -> WhatsApp -> API Setup. The temporary token expires in 24h;
# create a System User token for anything longer-lived.
WHATSAPP_ACCESS_TOKEN=
# The "Phone number ID" (NOT the phone number) of your test/business number.
WHATSAPP_PHONE_NUMBER_ID=

# --- behaviour --------------------------------------------------------------
# echo    = demo bookkeeping bot replies on WhatsApp (default)
# forward = POST each event to your main app (set FORWARD_URL + FORWARD_SECRET)
# log     = only log events (pure webhook testing, never calls WhatsApp)
SINK_MODE=echo
# FORWARD_URL=https://your-main-app.example.com/internal/whatsapp
# FORWARD_SECRET=
AUTO_MARK_READ=true

# --- optional ---------------------------------------------------------------
# PORT=8080                       (Railway sets this for you)
# GRAPH_API_VERSION=v26.0
# GRAPH_BASE_URL=https://graph.facebook.com
# MAX_BODY_BYTES=1048576
# MEDIA_MAX_BYTES=16777216
# RUST_LOG=info,sqlx=warn

# Local throwaway testing ONLY: skips webhook signature verification.
# INSECURE_SKIP_SIGNATURE=true
